<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Sports Store - Blockchain Pro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --accent: #38bdf8;
            --text-main: #f8fafc;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden; 
        }

        .navbar-custom {
            background-color: #111827;
            border-bottom: 2px solid var(--accent);
            padding: 1rem 2rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .category-title {
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
            display: block;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-custom mb-4">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <span class="navbar-brand text-white fw-bold m-0 h3">
                <i class="bi bi-cpu-fill text-info me-2"></i>SPORTS <span style="color:var(--accent)">STORE</span>
            </span>
            <div class="d-flex align-items-center gap-3">
                <a href="/Home/BlockchainExplorer" class="btn btn-outline-info btn-sm">
                    <i class="bi bi-link-45deg"></i> Explorer
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="row">
            
            @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Node")
            {
                <div class="col-md-3">
                    <span class="category-title fw-bold">Categories</span>
                    <vc:navigation-menu />
                </div>
                <div class="col-md-9">
                    @RenderBody()
                </div>
            }
            else
            {
                
                <div class="col-12">
                    @RenderBody()
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>