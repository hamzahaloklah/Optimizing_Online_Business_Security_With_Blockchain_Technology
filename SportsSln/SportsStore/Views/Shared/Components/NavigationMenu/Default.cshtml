@model IEnumerable<string>

<div class="d-grid gap-2">
    <a class="btn @(ViewBag.SelectedCategory == null ? "btn-primary" : "btn-outline-secondary") text-start"
       asp-action="Index" asp-controller="Home" asp-route-category="">
        Home / All
    </a>

    @foreach (string category in Model ?? Enumerable.Empty<string>())
    {
        <a class="btn @(category == ViewBag.SelectedCategory ? "btn-primary": "btn-outline-secondary") text-start"
           asp-action="Index" asp-controller="Home" asp-route-category="@category"
           asp-route-productPage="1">
            @category
        </a>
    }
</div>